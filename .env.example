# ---------------------------------------------------------------------------
# Alumni Hub — environment configuration
#
# Copy to `.env` and fill in real values. `.env` is already in .gitignore.
# Every variable below also has a hard-coded fallback in app.py / config.py,
# which is why the app boots without a .env at all. Do not rely on those.
# ---------------------------------------------------------------------------

# --- Core ------------------------------------------------------------------
SECRET_KEY=generate-with-python-c-import-secrets-print-secrets-token_hex-32
FLASK_ENV=development

# --- Local database --------------------------------------------------------
# Used ONLY when TURSO_DATABASE_URL is empty.
DB_NAME=data/college_pro.db

# --- Turso Cloud -----------------------------------------------------------
# When TURSO_DATABASE_URL is set, the app talks to Turso over HTTP and
# DB_NAME is ignored. Leave this empty to keep using the local SQLite file.
# Copy both values from https://turso.tech -> your database -> web/CLI tokens.
#
# TURSO_DATABASE_URL=https://alumni-hub-yourname.turso.io
# TURSO_AUTH_TOKEN=your-database-token
#
# Which engine is your database?
#   libsql   (default) — databases created from the Turso dashboard
#   tursodb            — databases created with `turso db create --tursodb`
# TURSO_ENGINE=libsql

# --- Email (Gmail SMTP, needed for OTP delivery) ----------------------------
# Requires 2FA + an App Password, NOT your account password.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your.address@gmail.com
MAIL_PASSWORD=your-16-char-google-app-password

# --- Application ------------------------------------------------------------
# Where the admin receives contact-form and issue-report emails.
ADMIN_EMAIL=your.address@gmail.com
BASE_URL=http://localhost:5000