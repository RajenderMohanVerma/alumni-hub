{
  "version": 2,
  "regions": ["bom1"],
  "builds": [
    {
      "src": "app.py",
      "use": "@vercel/python",
      "config": {
        "maxDuration": 15
      }
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "app.py",
      "headers": {
        "cache-control": "public, max-age=31536000, s-maxage=31536000, immutable"
      }
    },
    {
      "src": "/manifest.json",
      "dest": "app.py",
      "headers": {
        "cache-control": "public, max-age=86400"
      }
    },
    {
      "src": "/favicon.ico",
      "dest": "app.py",
      "headers": {
        "cache-control": "public, max-age=86400"
      }
    },
    {
      "src": "/(.*)",
      "dest": "app.py"
    }
  ],
  "env": {
    "FLASK_ENV": "production"
  }
}
